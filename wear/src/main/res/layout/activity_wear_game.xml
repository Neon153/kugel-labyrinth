<?xml version="1.0" encoding="utf-8"?>
<!--
    Spielbildschirm der Uhr. Das Labyrinth liegt im Quadrat, das in den Kreis passt;
    Zeit (oben) und Stufe/Tempo (unten) stehen in den freien Kreissegmenten.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <com.example.kugellabyrinth.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Feste Breite: setText löst nur ein Neuzeichnen aus, kein Relayout -->
    <TextView
        android:id="@+id/textTimer"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/hud_margin"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/timer_initial"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMode"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/hud_margin"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />
</FrameLayout>
